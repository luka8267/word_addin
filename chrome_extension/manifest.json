{
  "manifest_version": 3,
  "name": "bunken Web Importer",
  "version": "0.2.11",
  "description": "現在の論文ページから文献情報とPDF候補を取得し、bunken に保存します。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.vercel.app/*",
    "https://raw.githubusercontent.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "action": {
    "default_title": "bunken に保存",
    "default_popup": "popup.html"
  }
}
